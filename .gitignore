# virtual environment created by the setup instructions
.venv/
venv/

# python / test caches and scratch
__pycache__/
*.pyc
.pytest_cache/
.pytest_tmp/
.ipynb_checkpoints/
# kernel spec generated by notebooks/build_notebooks.py (machine-specific path)
.jupyter/
# scratch outputs written by the notebooks while executing
notebooks/output/

# per-run raw snapshots and logs are regenerated by every pipeline run.
# The committed example run under data/raw/ and output/ is kept as evidence;
# additional runs are ignored so the repository does not grow unbounded.
data/raw/run_*/
!data/raw/run_example/
output/runs/*/
!output/runs/run_example/

# editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
# scratch outputs of the challenge notebooks and the walkthrough run
Challenges/output/
notebooks/walkthrough_run/
# per-period and replay working copies (evidence folders under output/periods/<period>/ are committed;
# their run folders, processed tables and raw snapshots are regenerated by `--weekly` / `--replay`)
output/periods/*/runs/
data/processed/periods/
data/processed/replays/
# per-week charts and self-contained HTML dashboards are regenerated by `--weekly`;
# the weekly metrics, gates, memos and the scorecard are the committed evidence
output/periods/*/charts/
output/periods/*/dashboard.html
# the published copy of the visual story lives in output/visuals/ (the run folder copy is identical)
output/runs/*/visuals/
